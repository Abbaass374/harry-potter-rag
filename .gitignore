# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Environment / secrets ---
.env
*.log

# --- Data: don't redistribute the source books, don't commit large artifacts ---
data/raw/*.pdf
data/processed/*.md
data/processed/*.csv

# The Qdrant vector store IS committed so the Streamlit Cloud app can load it.
# NOTE: its chunk payloads contain the book text, so the repo must stay PRIVATE.
# Only the runtime lock file is ignored.
backend/data/vector_store/.lock

# Streamlit secrets (never commit real secrets)
.streamlit/secrets.toml

# --- OS / editor ---
.DS_Store
.vscode/
.idea/
