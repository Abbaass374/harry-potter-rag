# ---------------------------------------------------------------------------
# Backend configuration. Copy this file to `.env` and adjust as needed:
#     cp .env.example .env
# Every variable has a sensible default in app/core/config.py; you usually only
# need a .env if you deviate from the defaults below.
# ---------------------------------------------------------------------------

# --- General ---
APP_NAME="Harry Potter RAG API"
LOG_LEVEL=INFO

# --- Vector store (Qdrant, embedded/local mode) ---
# Path to the on-disk Qdrant store produced by the notebook / ingest step.
# Default resolves to backend/data/vector_store.
QDRANT_PATH=./data/vector_store
# Leave QDRANT_URL empty for embedded mode. Set it (e.g. http://localhost:6333)
# to connect to a running Qdrant server instead.
# QDRANT_URL=
COLLECTION_NAME=harry_potter

# --- Embeddings (must match what the notebook used to build the store) ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- LLM (Groq hosted API) ---
# Get a free key at https://console.groq.com/keys and paste it below.
# NEVER commit this file (.gitignore already excludes .env).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT=60

# --- Retrieval / grounding ---
TOP_K=8
# Minimum cosine similarity (0-1) for a chunk to count as relevant. Below this,
# the API refuses ("I don't know") rather than answering from model knowledge.
MIN_RELEVANCE_SCORE=0.30
MAX_CONTEXT_CHARS=8000

# --- CORS (comma-separated allowed origins for the Streamlit frontend) ---
CORS_ORIGINS_RAW=http://localhost:8501,http://127.0.0.1:8501
